    { "source": "/:path*", "has": [{ "type": "host", "value": "www.suph.ai" }], "destination": "https://suphian.com/:path*", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "suph.ai" }], "destination": "https://suphian.com/", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.suphian.com" }], "destination": "https://suphian.com/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "suph.ai" }], "destination": "https://suphian.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.suphian.com" }], "destination": "https://suphian.com/:path*", "permanent": true },
